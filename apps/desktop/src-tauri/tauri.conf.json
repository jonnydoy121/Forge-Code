{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge-Code",
  "version": "0.0.0",
  "identifier": "dev.forge.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "label": "main", "title": "Forge-Code", "width": 1200, "height": 800 }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"], "externalBin": ["binaries/forge-runtime"] }
}
