{
  "name": "forge",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test:rust": "cargo test --workspace",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "dev": "npm run build:sidecar && npm run tauri dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "e2e": "npm run e2e -w apps/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.0.0",
    "pyright": "^1.1.414",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "typescript-language-server": "^6.1.0",
    "vitest": "^2.1.0"
  }
}
