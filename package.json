{
  "name": "forge",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test:rust": "cargo test --workspace",
    "dev": "npm run tauri dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "e2e": "npm run e2e -w apps/desktop"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
